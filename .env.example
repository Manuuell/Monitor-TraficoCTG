# Copiar a .env y completar con los valores reales
# NO subir .env al repositorio (esta en .gitignore)

# Clave API de TomTom (cada VPS usa una diferente)
TOMTOM_API_KEY=TU_CLAVE_API

# Rotacion automatica de llaves: lista separada por comas de TODAS las llaves
# disponibles (una por cuenta). El ETL las reparte en round-robin y, cuando una
# se agota (403 InsufficientFunds), salta a la siguiente sin perder la corrida.
# Si esta vacio, se usa TOMTOM_API_KEY como unica llave.
TOMTOM_API_KEYS=LLAVE_CUENTA_1,LLAVE_CUENTA_2,LLAVE_CUENTA_3,LLAVE_CUENTA_4

# Llaves de reserva: solo se usan cuando todas las de TOMTOM_API_KEYS estan
# agotadas. Una llave agotada se vuelve a probar cada REPROBAR_AGOTADA_HORAS
# horas, asi el ETL regresa a las principales en cuanto alguna recibe creditos.
TOMTOM_API_KEYS_RESERVA=LLAVE_RESERVA_1,LLAVE_RESERVA_2
REPROBAR_AGOTADA_HORAS=6

# Cuota gratuita mensual por cuenta (TomTom free tier)
CUOTA_MENSUAL_LLAVE=20000

# Identificador del VPS: "1" o "2"
# VPS 1 corre Turnos 1 y 2 con Key 1
# VPS 2 corre Turnos 3 y 4 con Key 2
VPS_ID=1

# Google Drive folder ID donde se suben los CSV
DRIVE_FOLDER_ID=1zGbiM_tpJQSmEDjhXJsDOYw4yFhFqjhd

# Google Sheet ID donde se acumulan las filas
SHEET_ID=1z4usMbSsF40PBOqZeVO3bnrRKfei-BHUl1mAXeMVhbo
SHEET_TAB=datos

# Si esta en "false", el script NO sube a Google (util para pruebas)
SUBIR_A_GOOGLE=true
